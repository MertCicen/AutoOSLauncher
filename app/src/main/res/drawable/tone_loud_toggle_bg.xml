<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#0029e0" />
            <stroke android:width="2.0dp" android:color="#dde7ff" />
            <corners android:radius="2.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#191b22" />
            <stroke android:width="2.0dp" android:color="#0029e0" />
            <corners android:radius="2.0dp" />
        </shape>
    </item>
</selector>
