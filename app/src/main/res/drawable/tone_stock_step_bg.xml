<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#243040" />
            <stroke android:width="2.0dp" android:color="#dde7ff" />
            <corners android:radius="1.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#111821" />
            <stroke android:width="2.0dp" android:color="#a6b5c5da" />
            <corners android:radius="1.0dp" />
        </shape>
    </item>
</selector>
