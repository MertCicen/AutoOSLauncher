<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sample_blue_wave"
    android:tag="launcher_wallpaper_root">

    <View
        android:id="@id/view2"
        android:layout_width="0.0dp"
        android:layout_height="2.0dp"
        android:background="@drawable/line_gradient"
        app:layout_constraintBottom_toTopOf="@id/guidelineyatay4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guidelineyatay4" />

    <ImageView
        android:id="@id/imageView"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:contentDescription="@string/vehicle_image"
        app:layout_constraintBottom_toTopOf="@id/guidelineyatay8"
        app:layout_constraintEnd_toStartOf="@id/guideline7"
        app:layout_constraintStart_toStartOf="@id/guideline10"
        app:layout_constraintTop_toTopOf="@id/guidelineyatay9"
        app:layout_constraintVertical_bias="0.5"
        app:srcCompat="@drawable/autoos_concept_car" />

    <FrameLayout
        android:id="@id/custom_sign_container"
        android:layout_width="72.0dp"
        android:layout_height="72.0dp"
        android:layout_marginStart="14.0dp"
        android:layout_marginTop="64.0dp"
        android:clickable="true"
        android:contentDescription="@string/custom_sign_choose"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@id/guidelineyatay9"
        app:layout_constraintEnd_toStartOf="@id/guideline6"
        app:layout_constraintStart_toStartOf="@id/imageView"
        app:layout_constraintTop_toTopOf="@id/guidelineyatay4">

        <ImageView
            android:id="@id/custom_sign_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/autoos_home_logo"
            android:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@id/current_road_name_text"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_marginStart="12.0dp"
        android:ellipsize="end"
        android:fontFamily="sans"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/custom_header_default"
        android:textColor="#ffffff"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="20.0sp"
        app:autoSizeMinTextSize="10.0sp"
        app:autoSizeStepGranularity="1.0sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="@id/custom_sign_container"
        app:layout_constraintEnd_toStartOf="@id/guideline8"
        app:layout_constraintStart_toEndOf="@id/custom_sign_container"
        app:layout_constraintTop_toTopOf="@id/custom_sign_container" />

    <View
        android:id="@id/view"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:background="#F503070E"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guidelineyatay8" />

    <View
        android:id="@+id/home_bottom_accent"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="#0029E0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guidelineyatay8" />

    <View
        android:id="@+id/home_apps_underline"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:background="#0029E0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline6"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@id/current_speed_text"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:gravity="center"
        android:text="@string/current_speed_waiting"
        android:textColor="#ffffff"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="32.0sp"
        app:autoSizeMinTextSize="8.0sp"
        app:autoSizeStepGranularity="1.0sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@id/guidelineyatay7"
        app:layout_constraintEnd_toStartOf="@id/guideline5"
        app:layout_constraintStart_toStartOf="@id/guideline4"
        app:layout_constraintTop_toTopOf="@id/guidelineyatay9" />

    <TextView
        android:id="@id/average_speed_text"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:gravity="center"
        android:text="@string/average_speed_waiting"
        android:textColor="#ffffff"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="32.0sp"
        app:autoSizeMinTextSize="8.0sp"
        app:autoSizeStepGranularity="1.0sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@id/guidelineyatay6"
        app:layout_constraintEnd_toStartOf="@id/guideline5"
        app:layout_constraintStart_toStartOf="@id/guideline4"
        app:layout_constraintTop_toTopOf="@id/guidelineyatay7" />

    <TextView
        android:id="@id/trip_time_text2"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:gravity="center"
        android:text="00:00"
        android:textColor="#ffffff"
        app:autoSizeMaxTextSize="32.0sp"
        app:autoSizeMinTextSize="8.0sp"
        app:autoSizeStepGranularity="1.0sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@id/guidelineyatay6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/guideline5"
        app:layout_constraintTop_toTopOf="@id/guidelineyatay7" />

    <View
        android:id="@id/apps_button_bg"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:alpha="0.0"
        android:background="#27001ae0"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guidelineyatay8" />

    <View
        android:id="@id/apps_button"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_marginStart="20.0dp"
        android:background="@drawable/apps_button"
        android:clickable="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toStartOf="@id/textView"
        app:layout_constraintHeight_percent="0.03"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guidelineyatay8"
        app:layout_constraintWidth_percent="0.03" />

    <TextView
        android:id="@id/textView"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:ellipsize="end"
       
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/apps"
        android:textAlignment="center"
        android:textColor="#ffffff"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline6"
        app:layout_constraintStart_toEndOf="@id/apps_button"
        app:layout_constraintTop_toTopOf="@id/guidelineyatay8" />

    <ImageView
        android:id="@id/shortcut_1_icon"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_marginStart="20.0dp"
        android:clickable="false"
        android:scaleType="fitCenter"
        android:src="@drawable/home_shortcut_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toStartOf="@id/shortcut_1_label"
        app:layout_constraintHeight_percent="0.03"
        app:layout_constraintStart_toStartOf="@id/guideline6"
        app:layout_constraintTop_toTopOf="@id/guidelineyatay8"
        app:layout_constraintWidth_percent="0.03" />

    <TextView
        android:id="@id/shortcut_1_label"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/add_apps"
        android:textAlignment="center"
        android:textColor="#ffffff"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline7"
        app:layout_constraintStart_toEndOf="@id/shortcut_1_icon"
        app:layout_constraintTop_toTopOf="@id/guidelineyatay8" />

    <ImageView
        android:id="@id/shortcut_2_icon"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_marginStart="20.0dp"
        android:clickable="false"
        android:scaleType="fitCenter"
        android:src="@drawable/home_shortcut_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toStartOf="@id/shortcut_2_label"
        app:layout_constraintHeight_percent="0.03"
        app:layout_constraintStart_toStartOf="@id/guideline7"
        app:layout_constraintTop_toTopOf="@id/guidelineyatay8"
        app:layout_constraintWidth_percent="0.03" />

    <TextView
        android:id="@id/shortcut_2_label"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/add_apps"
        android:textAlignment="center"
        android:textColor="#ffffff"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline8"
        app:layout_constraintStart_toEndOf="@id/shortcut_2_icon"
        app:layout_constraintTop_toTopOf="@id/guidelineyatay8" />

    <ImageView
        android:id="@id/shortcut_3_icon"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_marginStart="20.0dp"
        android:clickable="false"
        android:scaleType="fitCenter"
        android:src="@drawable/home_shortcut_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toStartOf="@id/shortcut_3_label"
        app:layout_constraintHeight_percent="0.03"
        app:layout_constraintStart_toStartOf="@id/guideline8"
        app:layout_constraintTop_toTopOf="@id/guidelineyatay8"
        app:layout_constraintWidth_percent="0.03" />

    <TextView
        android:id="@id/shortcut_3_label"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/add_apps"
        android:textAlignment="center"
        android:textColor="#ffffff"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline9"
        app:layout_constraintStart_toEndOf="@id/shortcut_3_icon"
        app:layout_constraintTop_toTopOf="@id/guidelineyatay8" />

    <ImageView
        android:id="@id/shortcut_4_icon"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_marginStart="20.0dp"
        android:clickable="false"
        android:scaleType="fitCenter"
        android:src="@drawable/home_shortcut_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toStartOf="@id/shortcut_4_label"
        app:layout_constraintHeight_percent="0.03"
        app:layout_constraintStart_toStartOf="@id/guideline9"
        app:layout_constraintTop_toTopOf="@id/guidelineyatay8"
        app:layout_constraintWidth_percent="0.03" />

    <TextView
        android:id="@id/shortcut_4_label"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/add_apps"
        android:textAlignment="center"
        android:textColor="#ffffff"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/shortcut_4_icon"
        app:layout_constraintTop_toTopOf="@id/guidelineyatay8" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@id/guidelineyatay4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.1" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@id/guidelineyatay9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.33" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@id/guidelineyatay7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.45" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@id/guidelineyatay6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.57" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@id/guidelineyatay23"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.69" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@id/guidelineyatay8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.88" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@id/guideline4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.45" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@id/guideline10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@id/guideline5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.73" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@id/guideline6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.2" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@id/guideline7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.4" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@id/guideline8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.6" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@id/guideline9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.8" />

    <TextClock
        android:id="@id/textClock"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:autoText="true"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:gravity="center"
        android:textAlignment="center"
        android:textSize="24.0sp"
        app:layout_constraintBottom_toTopOf="@id/guidelineyatay4"
        app:layout_constraintEnd_toStartOf="@id/guideline8"
        app:layout_constraintStart_toStartOf="@id/guideline7"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@id/settings"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_marginTop="7.0dp"
        android:layout_marginEnd="7.0dp"
        android:background="@drawable/gear"
        android:backgroundTint="#717171"
        app:layout_constraintBottom_toTopOf="@id/guidelineyatay4"
        app:layout_constraintDimensionRatio="H,1.2:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.04"
        app:layout_constraintHorizontal_bias="0.991"
        app:layout_constraintStart_toStartOf="@id/guideline9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.052"
        app:layout_constraintWidth_percent="0.04" />
</androidx.constraintlayout.widget.ConstraintLayout>
