<?xml version='1.0' encoding='utf-8'?>
<resources>
  <style name="Base.Theme.AutoOSLauncher" parent="@style/Theme.AppCompat.NoActionBar">
    <item name="android:windowBackground">#000000</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:windowAnimationStyle">@null</item>
    <item name="android:windowFullscreen">true</item>
    <item name="android:windowDisablePreview">true</item>
    <item name="android:hardwareAccelerated">true</item>
    <item name="android:statusBarColor">#000000</item>
    <item name="android:navigationBarColor">#000000</item>
    <item name="colorOnPrimary">#ffffff</item>
    <item name="colorPrimary">#000000</item>
    <item name="colorPrimaryVariant">#000000</item>
    <item name="windowNoTitle">true</item>
  </style>
  <style name="Theme.AutoOSLauncher" parent="@style/Base.Theme.AutoOSLauncher" />
  <style name="PhoneKeyStyle">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">52dp</item>
    <item name="android:layout_weight">1</item>
    <item name="android:layout_marginStart">4dp</item>
    <item name="android:layout_marginEnd">4dp</item>
    <item name="android:background">#A5020202</item>
    <item name="android:gravity">center</item>
    <item name="android:textColor">#FFFFFF</item>
    <item name="android:textSize">24sp</item>
    <item name="android:textStyle">bold</item>
  </style>
  <style name="PhoneActionStyle">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">44dp</item>
    <item name="android:layout_weight">1</item>
    <item name="android:layout_marginStart">4dp</item>
    <item name="android:layout_marginEnd">4dp</item>
    <item name="android:background">#CC111111</item>
    <item name="android:gravity">center</item>
    <item name="android:textColor">#FFFFFF</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textStyle">bold</item>
  </style>
  <style name="EqPadButton">
    <item name="android:layout_width">84dp</item>
    <item name="android:layout_height">84dp</item>
    <item name="android:layout_margin">6dp</item>
    <item name="android:background">@drawable/eq_pad_button_bg</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
    <item name="android:gravity">center</item>
    <item name="android:textColor">#2A1830</item>
    <item name="android:textSize">42sp</item>
    <item name="android:textStyle">normal</item>
  </style>
  <style name="AppsPageButton">
    <item name="android:background">@drawable/bg_app_button</item>
    <item name="android:layout_width">0.0dp</item>
    <item name="android:layout_height">0.0dp</item>
    <item name="layout_constraintDimensionRatio">4:3</item>
    <item name="layout_constraintWidth_percent">0.2</item>
  </style>
  <style name="AppsPageIcon">
    <item name="android:layout_width">0.0dp</item>
    <item name="android:layout_height">0.0dp</item>
    <item name="android:layout_margin">10.0dp</item>
    <item name="layout_constraintEnd_toEndOf">parent</item>
    <item name="layout_constraintStart_toStartOf">parent</item>
    <item name="layout_constraintTop_toTopOf">parent</item>
  </style>
  <style name="AppsPageBorder">
    <item name="android:background">#0026ff</item>
    <item name="android:layout_width">0.0dp</item>
    <item name="android:layout_height">5.0dp</item>
    <item name="android:layout_marginTop">50.0dp</item>
    <item name="layout_constraintBottom_toBottomOf">parent</item>
    <item name="layout_constraintEnd_toEndOf">parent</item>
    <item name="layout_constraintStart_toStartOf">parent</item>
    <item name="layout_constraintTop_toTopOf">parent</item>
  </style>
  <style name="AppsPageText">
    <item name="android:textColor">@color/white</item>
    <item name="android:layout_width">0.0dp</item>
    <item name="android:layout_height">0.0dp</item>
    <item name="android:textAlignment">center</item>
    <item name="autoSizeTextType">uniform</item>
    <item name="layout_constraintBottom_toBottomOf">parent</item>
    <item name="layout_constraintEnd_toEndOf">parent</item>
    <item name="layout_constraintHeight_percent">0.25</item>
    <item name="layout_constraintStart_toStartOf">parent</item>
    <item name="layout_constraintWidth_percent">1.0</item>
  </style>
</resources>